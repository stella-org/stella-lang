-- What a guest synthesizer running on Steam is written against.
--
-- A guest asks the host through one effect operation, `command`, and the
-- values it sends and receives are data types of this module. They mirror the
-- kernel's vocabulary constructor for constructor, so that a request a guest
-- builds is the request a host script makes. Only the control a guest has any
-- use for is exposed: the attempt is finished by the guest returning, not by a
-- command, and transactions are opened and closed without the guest ever
-- holding their tokens.
--
-- A guest is written against typed operations, not against `command`. Each
-- kernel operation has a function of the host facade's name, taking the
-- request's fields in order and giving back what its answer carries;
-- `transact` runs a candidate, and `synthesizer` makes a policy into what an
-- invocation calls. The operations and `transact` run at
-- `( Abort, Breach, Kernel )`, and so does a policy written with them;
-- `synthesizer` narrows it to `( Kernel )`, the one effect the root boundary
-- answers.
--
-- `Abort` is how a candidate fails, and `Breach` how a host answers outside
-- its contract. An operation answered `CandidateFailed` raises `Abort`, which
-- the innermost `transact` handles; any other answer it does not expect raises
-- `Breach`, which `transact` leaves for `synthesizer`. Both are raised by the
-- operations here and handled by `transact` and `synthesizer` alone: a policy
-- that performs or handles either itself is out of contract, and gains nothing
-- by it, the host's transactions and the result it finishes with being checked
-- where it holds them.
--
-- The module depends on nothing, so it has lists and optional values of its
-- own.
module Stella.Elab
  ( Handle
  , List(..)
  , Maybe(..)
  , Name(..)
  , RowElemKind(..)
  , KindView(..)
  , RowKey(..)
  , Literal(..)
  , PayloadView(..)
  , ConstraintView(..)
  , TypeView(..)
  , EntrySort(..)
  , Constant(..)
  , MessagePart(..)
  , KernelRequest(..)
  , BuildRequest(..)
  , TermRequest(..)
  , TreeRequest(..)
  , RecordRequest(..)
  , HandlerRequest(..)
  , SolveRequest(..)
  , ObserveRequest(..)
  , ReportRequest(..)
  , KernelAnswer(..)
  , GuestCommand(..)
  , GuestAnswer(..)
  , Kernel(..)
  , Abort(..)
  , Breach(..)
  , rootScope
  , typeVariable
  , typeConstructor
  , applyType
  , emptyRow
  , extendRow
  , unionRow
  , openForall
  , closeForall
  , openConstraint
  , closeConstraint
  , instantiateForall
  , instantiateScheme
  , localVariable
  , globalRef
  , literal
  , termApply
  , typeApply
  , constraintApply
  , openLambda
  , closeLambda
  , openTypeAbs
  , closeTypeAbs
  , openConstraintAbs
  , closeConstraintAbs
  , openLet
  , closeLet
  , openLetRec
  , closeLetRec
  , openJoin
  , closeJoin
  , jump
  , openCase
  , closeCase
  , leaf
  , guard
  , openBind
  , closeBind
  , recordField
  , openSwitchCtor
  , openSwitchLit
  , openSwitchKey
  , closeSwitch
  , recordEmpty
  , recordExtend
  , recordSelect
  , recordRestrict
  , recordUpdate
  , recordMerge
  , variantInject
  , variantWeaken
  , variantAbsurd
  , openEff
  , perform
  , openHandle
  , closeHandle
  , openRegion
  , closeRegion
  , readCell
  , writeCell
  , freshMetaType
  , isAssigned
  , unify
  , entails
  , require
  , subgoal
  , goalType
  , viewType
  , whnf
  , normalizeRow
  , kindOf
  , typeOf
  , localContext
  , localConstraints
  , lookupGlobal
  , declsWithAttr
  , throw
  , warn
  , postpone
  , transact
  , synthesizer
  ) where

-- A host token, which nothing a guest writes can take apart.
foreign type Handle :: Type

data List a = Nil | Cons a (List a)

data Maybe a = Nothing | Just a

-- A qualified name: its module, and its name there.
data Name = Name String String

data RowElemKind = RowType | RowEffect

data KindView
  = KindType
  | KindEffect
  | KindRow RowElemKind
  | KindFun KindView KindView
  | KindVar String
  | KindAnyRow

data RowKey
  = SymbolKey String
  | TagKey String
  | PositionKey Int
  | EffectKey Name
  | RegionKey String

data Literal
  = LitInt Int
  | LitNumber Number
  | LitString String
  | LitChar Char
  | LitBoolean Boolean

data PayloadView
  = TypePayload Handle
  | EffectPayload Name (List Handle)
  | RegionPayload String

data ConstraintView
  = LacksView RowKey Handle
  | DisjointView Handle Handle

data TypeView
  = VarType String
  | MetaType Handle
  | ConType Name (List KindView)
  | AppType Handle Handle
  | ForallType String KindView Handle
  | ConstrainedType ConstraintView Handle
  | NormalRow { elementKind :: Maybe RowElemKind, known :: List { key :: RowKey, payload :: PayloadView }, rigid :: List String, flexible :: List { meta :: Handle, type :: Handle } }

data EntrySort = ValueEntry | ForeignEntry | ConstructorEntry

data Constant
  = ConstantLiteral Literal
  | ConstantValue Name
  | ConstantConstructor Name (List Constant)
  | ConstantRecord (List { label :: String, value :: Constant })

data MessagePart
  = TextPart String
  | TypePart Handle
  | TermPart Handle
  | NamePart Name

data KernelRequest
  = BuildRequest BuildRequest
  | TermRequest TermRequest
  | TreeRequest TreeRequest
  | RecordRequest RecordRequest
  | HandlerRequest HandlerRequest
  | SolveRequest SolveRequest
  | ObserveRequest ObserveRequest
  | ReportRequest ReportRequest

data BuildRequest
  = RootScope
  | TypeVariable Handle String
  | TypeConstructor Handle Name (List KindView)
  | ApplyType Handle Handle Handle
  | EmptyRow Handle
  | ExtendRow Handle RowKey PayloadView Handle
  | UnionRow Handle Handle Handle
  | OpenForall Handle String KindView
  | CloseForall Handle Handle Handle
  | OpenConstraint Handle ConstraintView
  | CloseConstraint Handle Handle Handle
  | InstantiateForall Handle Handle Handle
  | InstantiateScheme Handle Name (List KindView)

data TermRequest
  = LocalVariable Handle String
  | GlobalRef Handle Name (List KindView)
  | LiteralTerm Handle Literal
  | TermApply Handle Handle Handle
  | TypeApply Handle Handle Handle
  | ConstraintApply Handle Handle
  | OpenLambda Handle String Handle
  | CloseLambda Handle Handle Handle Handle
  | OpenTypeAbs Handle String KindView
  | CloseTypeAbs Handle Handle Handle
  | OpenConstraintAbs Handle ConstraintView
  | CloseConstraintAbs Handle Handle Handle
  | OpenLet Handle String Handle
  | CloseLet Handle Handle Handle
  | OpenLetRec Handle (List { hint :: String, type :: Handle })
  | CloseLetRec Handle Handle (List Handle) Handle
  | OpenJoin Handle String (List { hint :: String, type :: Handle }) Handle
  | CloseJoin Handle Handle Handle Handle
  | Jump Handle Handle (List Handle)

data TreeRequest
  = OpenCase Handle (List Handle)
  | CloseCase Handle Handle (Maybe Handle) Handle
  | Leaf Handle Handle
  | Guard Handle Handle Handle Handle
  | OpenBind Handle Handle String
  | CloseBind Handle Handle Handle
  | RecordField Handle Handle RowKey
  | OpenSwitchCtor Handle Handle (List Name) Boolean
  | OpenSwitchLit Handle Handle (List Literal)
  | OpenSwitchKey Handle Handle (List RowKey) Boolean
  | CloseSwitch Handle Handle (List Handle) (Maybe Handle)

data RecordRequest
  = RecordEmpty Handle
  | RecordExtend Handle RowKey Handle Handle
  | RecordSelect Handle RowKey Handle
  | RecordRestrict Handle RowKey Handle
  | RecordUpdate Handle RowKey Handle Handle
  | RecordMerge Handle Handle Handle
  | VariantInject Handle RowKey Handle Handle
  | VariantWeaken Handle RowKey Handle Handle
  | VariantAbsurd Handle Handle Handle
  | OpenEff Handle Handle Handle

data HandlerRequest
  = Perform Handle RowKey PayloadView String (List Handle) Handle
  | OpenHandle Handle Handle RowKey PayloadView Handle Handle (List { op :: String, full :: Boolean })
  | CloseHandle Handle Handle Handle (List Handle)
  | OpenRegion Handle (List { key :: RowKey, type :: Handle })
  | CloseRegion Handle Handle Handle (List Handle)
  | ReadCell Handle Handle RowKey
  | WriteCell Handle Handle RowKey Handle

data SolveRequest
  = FreshMetaType Handle KindView
  | IsAssigned Handle
  | Unify Handle Handle Handle
  | Entails Handle ConstraintView
  | Require Handle ConstraintView
  | Subgoal Handle Handle Name

data ObserveRequest
  = GoalType Handle
  | ViewType Handle
  | Whnf Handle
  | NormalizeRow Handle
  | KindOf Handle
  | TypeOf Handle
  | LocalContext
  | LocalConstraints
  | LookupGlobal Name
  | DeclsWithAttr Name

data ReportRequest
  = Throw (List MessagePart)
  | Warn (List MessagePart)
  | Postpone (List Handle)

data KernelAnswer
  = UnitAnswer
  | HandleAnswer Handle
  | BooleanAnswer Boolean
  | TypeViewAnswer TypeView
  | RowViewAnswer { elementKind :: Maybe RowElemKind, known :: List { key :: RowKey, payload :: PayloadView }, rigid :: List String, flexible :: List { meta :: Handle, type :: Handle } }
  | KindViewAnswer KindView
  | ContextAnswer (List { name :: String, type :: Handle })
  | ConstraintsAnswer (List ConstraintView)
  | DeclAnswer (Maybe { name :: Name, sort :: EntrySort, kindVars :: List String, scheme :: Handle, attributes :: List { name :: Name, positional :: List Constant, keyword :: List { label :: String, value :: Constant } } })
  | NamesAnswer (List Name)
  | BinderAnswer { binder :: Handle, variable :: Handle, bodyScope :: Handle }
  | AssumptionAnswer { assumption :: Handle, bodyScope :: Handle }
  | ConstraintAbsAnswer { binder :: Handle, bodyScope :: Handle }
  | LetRecAnswer { binder :: Handle, variables :: List Handle, bodyScope :: Handle }
  | JoinAnswer { binder :: Handle, join :: Handle, params :: List Handle, definitionScope :: Handle, bodyScope :: Handle }
  | CaseAnswer { binder :: Handle, scrutinees :: List Handle, treeScope :: Handle }
  | SwitchCtorAnswer { binder :: Handle, branches :: List { scope :: Handle, fields :: List Handle }, fallback :: Maybe Handle }
  | SwitchLitAnswer { binder :: Handle, branches :: List Handle, fallback :: Handle }
  | SwitchKeyAnswer { binder :: Handle, branches :: List { scope :: Handle, payload :: Handle }, fallback :: Maybe { scope :: Handle, residual :: Handle } }
  | HandlerAnswer { binder :: Handle, returnClause :: { variable :: Handle, scope :: Handle }, clauses :: List { typeVariables :: List Handle, argument :: Handle, continuation :: Maybe Handle, scope :: Handle } }
  | RegionAnswer { binder :: Handle, name :: String, bodyScope :: Handle }

data GuestCommand
  = Kernel KernelRequest
  | BeginTransaction
  | CommitTransaction

data GuestAnswer
  = Returned KernelAnswer
  | TransactionBegun
  | TransactionCommitted
  | CandidateFailed

-- The one operation a guest asks the host through.
effect Kernel where
  command :: GuestCommand ->* GuestAnswer

-- A candidate failed, and the innermost `transact` is to answer `Nothing`.
effect Abort where
  failed :: forall a. Unit ->* a

-- The host answered as its contract says it never does. Only `synthesizer`
-- handles it.
effect Breach where
  breached :: forall a. Unit ->* a

-- A request performed, and what its answer is where it is `Returned`. A
-- candidate failure aborts to the innermost `transact`; any other answer is a
-- breach.
ask :: KernelRequest -> KernelAnswer / {| Abort, Breach, Kernel |}
ask request = case command (Kernel request) of
  Returned carried -> carried
  CandidateFailed -> failed ()
  _ -> breached ()

-- The typed operations: each one's request made from its arguments, asked, and
-- the answer taken apart where it is the one expected. Any other answer is a
-- breach. `throw` and `postpone` take none back: the host ends the attempt.

rootScope :: Unit -> Handle / {| Abort, Breach, Kernel |}
rootScope = \_ -> case ask (BuildRequest RootScope) of
  HandleAnswer carried -> carried
  _ -> breached ()

typeVariable :: Handle -> String -> Handle / {| Abort, Breach, Kernel |}
typeVariable x0 x1 = case ask (BuildRequest (TypeVariable x0 x1)) of
  HandleAnswer carried -> carried
  _ -> breached ()

typeConstructor :: Handle -> Name -> List KindView -> Handle / {| Abort, Breach, Kernel |}
typeConstructor x0 x1 x2 = case ask (BuildRequest (TypeConstructor x0 x1 x2)) of
  HandleAnswer carried -> carried
  _ -> breached ()

applyType :: Handle -> Handle -> Handle -> Handle / {| Abort, Breach, Kernel |}
applyType x0 x1 x2 = case ask (BuildRequest (ApplyType x0 x1 x2)) of
