entails :: Handle -> ConstraintView -> Boolean / {| Abort, Breach, Kernel |}
entails x0 x1 = case ask (SolveRequest (Entails x0 x1)) of
  BooleanAnswer carried -> carried
  _ -> breached ()

require :: Handle -> ConstraintView -> Unit / {| Abort, Breach, Kernel |}
require x0 x1 = case ask (SolveRequest (Require x0 x1)) of
  UnitAnswer -> ()
  _ -> breached ()

subgoal :: Handle -> Handle -> Name -> Handle / {| Abort, Breach, Kernel |}
subgoal x0 x1 x2 = case ask (SolveRequest (Subgoal x0 x1 x2)) of
  HandleAnswer carried -> carried
  _ -> breached ()

goalType :: Handle -> Handle / {| Abort, Breach, Kernel |}
goalType x0 = case ask (ObserveRequest (GoalType x0)) of
  HandleAnswer carried -> carried
  _ -> breached ()

viewType :: Handle -> TypeView / {| Abort, Breach, Kernel |}
viewType x0 = case ask (ObserveRequest (ViewType x0)) of
  TypeViewAnswer carried -> carried
  _ -> breached ()

whnf :: Handle -> Handle / {| Abort, Breach, Kernel |}
whnf x0 = case ask (ObserveRequest (Whnf x0)) of
  HandleAnswer carried -> carried
  _ -> breached ()

normalizeRow :: Handle -> { elementKind :: Maybe RowElemKind, known :: List { key :: RowKey, payload :: PayloadView }, rigid :: List String, flexible :: List { meta :: Handle, type :: Handle } } / {| Abort, Breach, Kernel |}
normalizeRow x0 = case ask (ObserveRequest (NormalizeRow x0)) of
  RowViewAnswer carried -> carried
  _ -> breached ()

kindOf :: Handle -> KindView / {| Abort, Breach, Kernel |}
kindOf x0 = case ask (ObserveRequest (KindOf x0)) of
  KindViewAnswer carried -> carried
  _ -> breached ()

typeOf :: Handle -> Handle / {| Abort, Breach, Kernel |}
typeOf x0 = case ask (ObserveRequest (TypeOf x0)) of
  HandleAnswer carried -> carried
  _ -> breached ()

localContext :: Unit -> List { name :: String, type :: Handle } / {| Abort, Breach, Kernel |}
localContext = \_ -> case ask (ObserveRequest LocalContext) of
  ContextAnswer carried -> carried
  _ -> breached ()

localConstraints :: Unit -> List ConstraintView / {| Abort, Breach, Kernel |}
localConstraints = \_ -> case ask (ObserveRequest LocalConstraints) of
  ConstraintsAnswer carried -> carried
  _ -> breached ()

lookupGlobal :: Name -> Maybe { name :: Name, sort :: EntrySort, kindVars :: List String, scheme :: Handle, attributes :: List { name :: Name, positional :: List Constant, keyword :: List { label :: String, value :: Constant } } } / {| Abort, Breach, Kernel |}
lookupGlobal x0 = case ask (ObserveRequest (LookupGlobal x0)) of
  DeclAnswer carried -> carried
  _ -> breached ()

declsWithAttr :: Name -> List Name / {| Abort, Breach, Kernel |}
declsWithAttr x0 = case ask (ObserveRequest (DeclsWithAttr x0)) of
  NamesAnswer carried -> carried
  _ -> breached ()

throw :: forall a. List MessagePart -> a / {| Abort, Breach, Kernel |}
throw x0 = case ask (ReportRequest (Throw x0)) of
  _ -> breached ()

warn :: List MessagePart -> Unit / {| Abort, Breach, Kernel |}
warn x0 = case ask (ReportRequest (Warn x0)) of
  UnitAnswer -> ()
  _ -> breached ()

postpone :: forall a. List Handle -> a / {| Abort, Breach, Kernel |}
postpone x0 = case ask (ReportRequest (Postpone x0)) of
  _ -> breached ()
-- A transaction opened, the candidate run with `Abort` handled, and the
-- transaction committed where it returns. A failure closes nothing here: the
-- host has closed the innermost transaction as it answered, which is this one,
-- the transactions a guest opens being nested as its calls of `transact` are.
transact :: forall a. (Unit -> a / {| Abort, Breach, Kernel |}) -> Maybe a / {| Abort, Breach, Kernel |}
transact candidate = case command BeginTransaction of
  TransactionBegun -> committed candidate
  _ -> breached ()

-- The candidate run with `Abort` handled, at a row that does not hold `Abort`
-- itself, and the transaction committed where it returns.
committed :: forall a. (Unit -> a / {| Abort, Breach, Kernel |}) -> Maybe a / {| Breach, Kernel |}
committed candidate = handle candidate () with
  Abort | failed _ -> Nothing
    | return result -> case command CommitTransaction of
      TransactionCommitted -> Just result
      CandidateFailed -> Nothing
      _ -> breached ()

-- A policy made into what an invocation calls. `Abort` reaching it, a candidate
-- failing outside every transaction, and `Breach` both end the policy with the
-- goal it was given, neither of which a conforming host brings about.
synthesizer :: (Handle -> Handle / {| Abort, Breach, Kernel |}) -> Handle -> Handle / {| Kernel |}
synthesizer policy goal = handle (handle policy goal with
    Abort | failed _ -> goal) with
  Breach | breached _ -> goal
