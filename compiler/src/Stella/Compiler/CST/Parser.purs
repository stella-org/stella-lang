    ("no goto row for state " <> show puppyState)
  Puppy.Deps.Just puppyRow -> case Puppy.Deps.find (\puppyEntry -> puppyEntry.on == puppyNonterminal) puppyRow of
    Puppy.Deps.Just puppyEntry -> puppyEntry.to
    Puppy.Deps.Nothing -> Puppy.Runtime.internalError
      ("no goto from state " <> show puppyState <> " on " <> show puppyNonterminal)

tableFor :: Int -> Puppy.Runtime.Table (Puppy.Deps.Maybe (C.SourceToken)) Puppy.Runtime.Value
tableFor puppyStart =
  { action: actionAt
  , goto: gotoAt
  , production: productionAt
  , semanticAction: semanticActionAt
  , terminalIndex
  , terminalValue
  , terminalName
  , endTerminal: 83
  , recovery: Puppy.Deps.Just { terminal: 84, value: Puppy.Runtime.box <<< toParseError }
  , startState: puppyStart
  }

-- | End of input is `Puppy.Deps.Nothing` to the driver and nothing at all to a
-- | caller, so an error that landed on it reports no token rather than one the
-- | caller has no way to name.
toParseError
  :: Puppy.Runtime.ParseError (Puppy.Deps.Maybe (C.SourceToken))
  -> Puppy.Runtime.ParseError (C.SourceToken)
toParseError puppyError =
  puppyError { found = Puppy.Deps.fromMaybe Puppy.Deps.Nothing puppyError.found }

fromResult
  :: forall puppyResult
   . Puppy.Deps.Either (Puppy.Runtime.ParseError (Puppy.Deps.Maybe (C.SourceToken))) Puppy.Runtime.Value
  -> Puppy.Deps.Either (Puppy.Runtime.ParseError (C.SourceToken)) puppyResult
fromResult = case _ of
  Puppy.Deps.Left puppyError -> Puppy.Deps.Left (toParseError puppyError)
  Puppy.Deps.Right puppyValue -> Puppy.Deps.Right (Puppy.Runtime.unbox puppyValue)

-- | Feed the parser from an array, without building a second one.
-- |
-- | The driver reads a `Puppy.Deps.Maybe` of the token type, and that is
-- | exactly what a lookup past the end of an array answers, so the same
-- | `Puppy.Deps.index` both reads a token and says there are no more.
runArray
  :: Array (C.SourceToken)
  -> Int
  -> Puppy.Runtime.Step (Puppy.Deps.Maybe (C.SourceToken)) Puppy.Runtime.Value
  -> Puppy.Deps.Either (Puppy.Runtime.ParseError (Puppy.Deps.Maybe (C.SourceToken))) Puppy.Runtime.Value
runArray puppyInput puppyIndex puppyStep = case puppyStep of
  Puppy.Runtime.Await puppyResume ->
    runArray puppyInput (puppyIndex + 1)
      (Puppy.Runtime.resume puppyResume (Puppy.Deps.index puppyInput puppyIndex))
  Puppy.Runtime.Done puppyValue -> Puppy.Deps.Right puppyValue
  Puppy.Runtime.Failed puppyError -> Puppy.Deps.Left puppyError

puppyFromRecovered
  :: forall puppyResult
   . Puppy.Runtime.RecoveryResult (Puppy.Deps.Maybe (C.SourceToken)) Puppy.Runtime.Value
  -> Puppy.Runtime.RecoveryResult (C.SourceToken) puppyResult
puppyFromRecovered = case _ of
  Puppy.Runtime.ParseSucceeded puppyValue ->
    Puppy.Runtime.ParseSucceeded (Puppy.Runtime.unbox puppyValue)
  Puppy.Runtime.ParseRecovered puppyErrors puppyValue ->
    Puppy.Runtime.ParseRecovered (map toParseError puppyErrors)
      (Puppy.Runtime.unbox puppyValue)
  Puppy.Runtime.ParseFailed puppyErrors ->
    Puppy.Runtime.ParseFailed (map toParseError puppyErrors)

parseModule :: Array (C.SourceToken) -> Puppy.Deps.Either (Puppy.Runtime.ParseError (C.SourceToken)) (C.Module)
parseModule puppyInput =
  fromResult (runArray puppyInput 0 (Puppy.Runtime.start (tableFor 0)))

parseModuleFrom
  :: forall m
   . Puppy.Deps.MonadRec m
  => m (Puppy.Deps.Maybe (C.SourceToken))
  -> m (Puppy.Deps.Either (Puppy.Runtime.ParseError (C.SourceToken)) (C.Module))
parseModuleFrom puppyNext =
  map fromResult (Puppy.Runtime.parseM (tableFor 0) puppyNext)

parseModuleRecovering :: Array (C.SourceToken) -> Puppy.Runtime.RecoveryResult (C.SourceToken) (C.Module)
parseModuleRecovering puppyInput =
  puppyFromRecovered
    (Puppy.Runtime.parseRecoveringAt (tableFor 0) (Puppy.Deps.index puppyInput))

parseModuleRecoveringFrom
  :: forall m
   . Puppy.Deps.MonadRec m
  => m (Puppy.Deps.Maybe (C.SourceToken))
  -> m (Puppy.Runtime.RecoveryResult (C.SourceToken) (C.Module))
parseModuleRecoveringFrom puppyNext =
  map puppyFromRecovered (Puppy.Runtime.parseMRecovering (tableFor 0) puppyNext)

