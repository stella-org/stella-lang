        n = Puppy.Runtime.unbox (Puppy.Runtime.slot 1 puppyValues)

        as = Puppy.Runtime.unbox (Puppy.Runtime.slot 2 puppyValues)

        c :: C.SourceToken
        c = Puppy.Runtime.unbox (Puppy.Runtime.slot 3 puppyValues)
      in
        Puppy.Runtime.box
          (({ range: { space: o.range.space, start: o.range.start, end: c.range.end }, name: n, args: as }) :: C.Attribute)
  , \_ ->
      Puppy.Runtime.box
        ([])
  , \puppyValues ->
      let
        xs = Puppy.Runtime.unbox (Puppy.Runtime.slot 0 puppyValues)
      in
        Puppy.Runtime.box
          (xs)
  , \puppyValues ->
      let
        x :: C.Argument
        x = Puppy.Runtime.unbox (Puppy.Runtime.slot 0 puppyValues)
      in
        Puppy.Runtime.box
          ([ x ])
  , \puppyValues ->
      let
        xs = Puppy.Runtime.unbox (Puppy.Runtime.slot 0 puppyValues)

        x :: C.Argument
        x = Puppy.Runtime.unbox (Puppy.Runtime.slot 1 puppyValues)
      in
        Puppy.Runtime.box
          (xs <> [ x ])
  , \puppyValues ->
      let
        t :: C.Type
        t = Puppy.Runtime.unbox (Puppy.Runtime.slot 0 puppyValues)
      in
        Puppy.Runtime.box
          ((t) :: C.Type)
  , \puppyValues ->
      let
        e :: C.Expr
        e = Puppy.Runtime.unbox (Puppy.Runtime.slot 0 puppyValues)
      in
        Puppy.Runtime.box
          ((e) :: C.Expr)
  , \_ -> Puppy.Runtime.internalError
      "the start production has no semantic action"
  , \_ -> Puppy.Runtime.internalError
      "the start production has no semantic action"
  , \_ -> Puppy.Runtime.internalError
      "the start production has no semantic action"
  ]

semanticActionAt :: Int -> Array Puppy.Runtime.Value -> Puppy.Runtime.Value
semanticActionAt puppyIndex = case Puppy.Deps.index semanticActionTable puppyIndex of
  Puppy.Deps.Just puppyFound -> puppyFound
  Puppy.Deps.Nothing -> Puppy.Runtime.internalError
    ("no semantic action " <> show puppyIndex)

