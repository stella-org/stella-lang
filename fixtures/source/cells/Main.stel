module Main where

import Data.List (List(..))

data Nat = Z | S Nat

data Pair a b = Pair a b

effect Tick where
  tick :: Unit ->* Nat

effect Peek where
  peek :: Unit ->* Nat

effect Ask where
  ask :: Unit ->* Nat

effect State s where
  get :: Unit ->* s
  put :: s ->* Unit

effect Choose where
  choose :: Unit ->* Boolean

append :: forall a. List a -> List a -> List a
append xs ys = case xs of
  Nil -> ys
  Cons x rest -> Cons x (append rest ys)

counted :: List Nat
counted =
  handle
    let a = tick () in
    let b = tick () in
    let c = tick () in
    Cons a (Cons b (Cons c Nil))
  with
    var n := Z
    Tick fast
      | tick _ ->
          let v = n! in
          let _ = n := S v in
          v

stated :: Nat
stated =
  handle
    let _ = put (S Z) in
    let x = get () in
    let _ = put (S x) in
    get ()
  with
    var s := Z
    State fast
      | get _ -> s!
      | put v -> s := v

shared :: Pair Nat Nat
shared =
  handle
    let _ = tick () in
    let _ = tick () in
    let a = peek () in
    let b = peek () in
    Pair a b
  with
    var n := Z
    Tick fast | tick _ ->
      let v = n! in
      let _ = n := S v in
      v
    Peek fast | peek _ -> n!

withState :: forall a. (Unit -> a / {| State Nat, Choose |}) -> a / {| Choose |}
withState k = handle k () with
  var s := Z
  State fast
    | get _ -> s!
    | put v -> s := v

copied :: List Nat
copied =
  handle
    withState \_ ->
      let _ = choose () in
      let x = get () in
      let _ = put (S x) in
      Cons x Nil
  with
    Choose
      | choose _ -> append (resume true) (resume false)

kept :: List Nat
kept =
  handle
    let _ = choose () in
    let x = get () in
    let _ = put (S x) in
    Cons x Nil
  with
    var s := Z
    State fast
      | get _ -> s!
      | put v -> s := v
    Choose
      | choose _ -> append (resume true) (resume false)

runCounter :: forall a e. (Unit -> a / {| Tick, ...e |}) -> a / {| ...e |}
runCounter k = handle k () with
  var n := Z
  Tick fast | tick _ -> let v = n! in let _ = n := S v in v

apart :: Pair Nat Nat
apart =
  handle
    let a = tick () in 
    let b = peek () in 
    Pair a b
  with
    var n := S (S Z)
    runCounter
    Peek fast | peek _ -> n!

reached :: Nat
reached = handle ask () with
  var c := S Z
  Ask fast | ask _ ->
    let outer = \_ -> c! in
    handle ask () with
      var c := Z
      Ask fast | ask _ -> outer ()
