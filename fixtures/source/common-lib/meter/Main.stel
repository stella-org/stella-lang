-- The module the handler and cell refusals are made from by changing what it
-- lowers to. `Meter` has two operations, and two cells, `reading` and `spare`,
-- stand around its handler, so a handler entry has a second clause and a
-- region entry a second cell to turn into a repeat of the first, and one of
-- each to leave out. `installed` opens the cells where their value is
-- consumed, and installs a handler of no cells where its value is; `inBranch`
-- opens the cells and their handler in tail position inside a branch.
module Main (installed, inBranch) where

import Base.Int as Int

effect Meter where
  bump :: Unit ->* Int
  peek :: Unit ->* Int

installed :: Int
installed = Int.add (handle Int.add (bump ()) 1 with
    var reading := 0
    var spare := 0
    Meter fast | bump _ -> let v = Int.add reading! 1 in let _ = reading := v in v
      | peek _ -> spare!) (handle bump () with
    Meter fast | bump _ -> 1
      | peek _ -> 0)

inBranch :: Boolean -> Int
inBranch b = case b of
  true -> handle bump () with
    var reading := 0
    var spare := 0
    Meter fast | bump _ -> let v = Int.add reading! 1 in let _ = reading := v in v
      | peek _ -> spare!
  false -> 0
