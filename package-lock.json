    },
    "node_modules/@stella-lang/cli": {
      "resolved": "stella",
      "link": true
    },
    "node_modules/@stella-lang/runtime": {
      "resolved": "js-runtime",
      "link": true
    },
    "stella": {
      "name": "@stella-lang/cli",
      "version": "0.1.0",
      "license": "MIT",
      "bin": {
        "stella": "index.js"
      }
    }
  }
}
