{
  "name": "@stella-lang/workspace",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "@stella-lang/workspace",
      "workspaces": [
        "js-runtime",
        "stella"
      ]
    },
    "js-runtime": {
      "name": "@stella-lang/runtime",
      "version": "0.1.0",
