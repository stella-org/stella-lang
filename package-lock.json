{
  "name": "@stella-lang/workspace",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "@stella-lang/workspace",
      "workspaces": [
        "js-runtime",
        "stellac",
        "compiler"
      ]
    },
    "compiler": {
      "name": "@stella-lang/lib-compiler",
      "devDependencies": {}
    },
    "js-runtime": {
      "name": "@stella-lang/runtime",
      "version": "0.1.0",
      "license": "MIT"
    },
    "node_modules/@stella-lang/lib-compiler": {
      "resolved": "compiler",
      "link": true
    },
    "node_modules/@stella-lang/runtime": {
      "resolved": "js-runtime",
      "link": true
    },
    "node_modules/@stella-lang/stellac": {
      "resolved": "stellac",
      "link": true
    },
    "stella": {
      "name": "@stella-lang/cli",
      "version": "0.1.0",
      "extraneous": true,
      "license": "MIT",
      "bin": {
        "stella": "index.js"
      }
    },
    "stellac": {
      "name": "@stella-lang/stellac",
      "version": "0.1.0",
      "license": "MIT",
      "bin": {
        "stella": "index.js"
      }
    }
  }
}
